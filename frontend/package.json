{
  "name": "frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --localhost --port 8081",
    "web:poll": "node --require ./scripts/metro-polling.cjs ./node_modules/expo/bin/cli start --web --localhost --port 8081",
    "typecheck": "tsc --noEmit",
    "test:e2e": "expo export --platform web && playwright test",
    "lint": "expo lint .",
    "test:model": "node --experimental-strip-types --test tests/task-model.test.ts"
  },
  "private": true
}
